| makeresults
| eval data="2026-08-25 09:01:12|10.10.20.15|WKSTN-104|jsmith|4625|Failure|Logon failure - bad password;
2026-08-25 09:01:18|10.10.20.15|WKSTN-104|jsmith|4625|Failure|Logon failure - bad password;
2026-08-25 09:01:25|10.10.20.15|WKSTN-104|jsmith|4625|Failure|Logon failure - bad password;
2026-08-25 09:01:31|10.10.20.15|WKSTN-104|jsmith|4625|Failure|Logon failure - bad password;
2026-08-25 09:01:42|10.10.20.15|WKSTN-104|jsmith|4625|Failure|Logon failure - bad password;
2026-08-25 09:02:03|10.10.20.15|WKSTN-104|jsmith|4624|Success|Successful interactive logon"
| makemv data delim=";"
| mvexpand data
| makemv data delim="|"
| eval timestamp=mvindex(data,0),
       source_ip=mvindex(data,1),
       host=mvindex(data,2),
       username=mvindex(data,3),
       event_id=mvindex(data,4),
       result=mvindex(data,5),
       event_description=mvindex(data,6)
| table timestamp source_ip host username event_id result event_description
| sort timestamp
