source="simulated_security_events.csv" sourcetype="csv"
(username="jsmith" OR username="SYSTEM")
| eval event_time=strptime(timestamp,"%Y-%m-%d %H:%M:%S")
| rex field=_raw "^[^,]+,[^,]+,(?<endpoint_host>[^,]+),"
| sort 0 event_time
| table timestamp source_ip endpoint_host username event_id event_category result event_description indicator severity
